#!/bin/bash

# Only run on new installation
if [[ "$1" != "new" ]]; then
    exit 0
fi

# Ensure directory exists and config file is created
SYSCTL_CONF="/etc/sysctl.d/perfsonar-toolkit-sysctl.conf"
mkdir -p /etc/sysctl.d
: > "$SYSCTL_CONF"  # create/truncate the file

# Default sysctl settings
declare -A SYSCTL_SETTINGS=(
    [net.core.rmem_max]=67108864
    [net.core.wmem_max]=67108864
    [net.ipv4.tcp_rmem]="4096 87380 33554432"
    [net.ipv4.tcp_wmem]="4096 65536 33554432"
    [net.ipv4.tcp_no_metrics_save]=1
    [net.ipv4.tcp_congestion_control]=htcp
    [net.ipv4.conf.all.arp_ignore]=1
    [net.ipv4.conf.all.arp_announce]=2
    [net.ipv4.conf.default.arp_filter]=1
    [net.ipv4.conf.all.arp_filter]=1
)

MAX_SPEED=0
MAX_MTU=0

# Check interfaces
for IFACE in /sys/class/net/*; do
    IFACE_NAME=$(basename "$IFACE")
    [[ "$IFACE_NAME" == "lo" ]] && continue

    # Speed
    if [[ -f "$IFACE/speed" ]]; then
        SPEED=$(cat "$IFACE/speed" 2>/dev/null)
        [[ "$SPEED" =~ ^[0-9]+$ ]] && SPEED=$((SPEED * 1000000))
        [[ "$SPEED" =~ ^[0-9]+$ ]] && (( SPEED > MAX_SPEED )) && MAX_SPEED=$SPEED
    fi

    # MTU
    if [[ -f "$IFACE/mtu" ]]; then
        MTU=$(cat "$IFACE/mtu")
        (( MTU > MAX_MTU )) && MAX_MTU=$MTU
    fi
done

# Tune based on speed
if (( MAX_SPEED >= 40000000000 )); then
    SYSCTL_SETTINGS[net.core.rmem_max]=536870912
    SYSCTL_SETTINGS[net.core.wmem_max]=536870912
    SYSCTL_SETTINGS[net.ipv4.tcp_rmem]="4096 87380 268435456"
    SYSCTL_SETTINGS[net.ipv4.tcp_wmem]="4096 65536 268435456"
elif (( MAX_SPEED >= 10000000000 )); then
    SYSCTL_SETTINGS[net.core.rmem_max]=268435456
    SYSCTL_SETTINGS[net.core.wmem_max]=268435456
    SYSCTL_SETTINGS[net.ipv4.tcp_rmem]="4096 87380 134217728"
    SYSCTL_SETTINGS[net.ipv4.tcp_wmem]="4096 65536 134217728"
fi

# MTU tuning
(( MAX_MTU > 8000 )) && SYSCTL_SETTINGS[net.ipv4.tcp_mtu_probing]=1

# OS-specific settings
if [[ -f /etc/os-release ]]; then
    . /etc/os-release
    case "$ID" in
        centos|rhel)
            [[ "$VERSION_ID" =~ ^7 ]] && SYSCTL_SETTINGS[net.core.default_qdisc]=fq
            [[ "$VERSION_ID" =~ ^6 && MAX_SPEED -ge 10000000000 ]] && SYSCTL_SETTINGS[net.core.netdev_max_backlog]=250000
            ;;
        debian)
            [[ "$VERSION_ID" =~ ^8 ]] && SYSCTL_SETTINGS[net.core.default_qdisc]=fq
            ;;
    esac
fi

# Write sysctl settings to file
{
    echo "####################################"
    echo "# Default perfSONAR sysctl settings"
    echo "####################################"
    for KEY in $(printf "%s\n" "${!SYSCTL_SETTINGS[@]}" | sort); do
        echo "$KEY = ${SYSCTL_SETTINGS[$KEY]}"
    done
} > "$SYSCTL_CONF"
