#!/bin/sh
set -e

SCRIPT="/usr/lib/perfsonar/scripts/configure_sysctl"
CONF="/etc/sysctl.d/perfsonar-toolkit-sysctl.conf"

case "$1" in
    configure)
        if [ -x "$SCRIPT" ]; then
            if [ -n "$2" ] && [ -f "$CONF" ]; then
                echo "Running: configure_sysctl upgrade $2"
                "$SCRIPT" upgrade "$2"
            else
                echo "Running: configure_sysctl new"
                "$SCRIPT" new
            fi
        fi

        # Apply sysctl settings
        if [ -x /lib/systemd/systemd-sysctl ]; then
            /lib/systemd/systemd-sysctl "$CONF"
        elif [ -x /etc/init.d/procps ]; then
            invoke-rc.d procps start
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        # Nothing to do
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac
